{
  "name": "tactics-arena-worlds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:browser": "playwright test",
    "test:browser:ai": "playwright test --config playwright.ai.config.ts",
    "test:release-artifact": "vitest run --config vite.release.config.ts",
    "release:package": "node scripts/package-release.mjs",
    "release:verify-repro": "node scripts/verify-clean-reproducibility.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
